<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.javaescape2.controllers.MastermindController"
      prefWidth="800" prefHeight="600"
      alignment="CENTER" spacing="15"
      style="-fx-background-color: #1a1a2e; -fx-padding: 30;">

    <Label text="Mastermind — Desamorce la bombe"
           style="-fx-font-size: 22px; -fx-text-fill: #e94560; -fx-font-weight: bold;"/>

    <VBox fx:id="historique" spacing="8" alignment="CENTER"/>

    <HBox fx:id="ligneActuelle" spacing="10" alignment="CENTER"/>

    <HBox spacing="10" alignment="CENTER">
        <Circle fx:id="c0" radius="15" fill="CRIMSON" onMouseClicked="#choisirCouleur0" style="-fx-cursor: hand;"/>
        <Circle fx:id="c1" radius="15" fill="FORESTGREEN" onMouseClicked="#choisirCouleur1" style="-fx-cursor: hand;"/>
        <Circle fx:id="c2" radius="15" fill="ROYALBLUE" onMouseClicked="#choisirCouleur2" style="-fx-cursor: hand;"/>
        <Circle fx:id="c3" radius="15" fill="GOLD" onMouseClicked="#choisirCouleur3" style="-fx-cursor: hand;"/>
        <Circle fx:id="c4" radius="15" fill="DARKORCHID" onMouseClicked="#choisirCouleur4" style="-fx-cursor: hand;"/>
        <Circle fx:id="c5" radius="15" fill="DARKORANGE" onMouseClicked="#choisirCouleur5" style="-fx-cursor: hand;"/>
    </HBox>

    <Button fx:id="btnValider" text="Valider"
            onAction="#valider"
            style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8 20;"/>

    <Label fx:id="lblTentatives"
           text="Tentatives restantes : 10"
           style="-fx-font-size: 14px; -fx-text-fill: #ffffff;"/>

</VBox>