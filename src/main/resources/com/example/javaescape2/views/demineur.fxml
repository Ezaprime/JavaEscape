<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.javaescape2.controllers.DemineurController"
      prefWidth="800" prefHeight="600"
      alignment="CENTER" spacing="15"
      style="-fx-background-color: #1a1a2e; -fx-padding: 20;">

    <Label text="Demineur — Localise la bombe"
           style="-fx-font-size: 22px; -fx-text-fill: #e94560; -fx-font-weight: bold;"/>

    <Label fx:id="lblStatus"
           text="Trouve toutes les cases sans bombe !"
           style="-fx-font-size: 14px; -fx-text-fill: #ffffff;"/>

    <GridPane fx:id="grid"
              hgap="3" vgap="3"
              alignment="CENTER"/>

    <Button fx:id="btnRecommencer"
            text="Recommencer"
            onAction="#recommencer"
            style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8 20;"/>
</VBox>