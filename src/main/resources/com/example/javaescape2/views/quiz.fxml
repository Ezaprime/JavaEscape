<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.javaescape2.controllers.QuizController"
      prefWidth="800" prefHeight="600"
      alignment="CENTER" spacing="20"
      style="-fx-background-color: #1a1a2e; -fx-padding: 40;">

    <Label fx:id="lblScore"
           text="0/5"
           style="-fx-font-size: 20px; -fx-text-fill: #e94560; -fx-font-weight: bold;"/>

    <Label fx:id="lblQuestion"
           text="Chargement..."
           wrapText="true"
           style="-fx-font-size: 16px; -fx-text-fill: #ffffff;"
           maxWidth="600" alignment="CENTER"/>

    <HBox fx:id="hboxReponses" spacing="15" alignment="CENTER"/>

    <Label fx:id="lblFeedback"
           text=""
           style="-fx-font-size: 14px; -fx-text-fill: #ffffff;"/>

    <Button fx:id="btnSuivant"
            text="Suivant"
            onAction="#questionSuivante"
            visible="false"
            style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8 20;"/>
</VBox>